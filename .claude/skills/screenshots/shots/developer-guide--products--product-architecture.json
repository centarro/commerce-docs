 {"file": "product-categories-ui-6.jpg", "url": "/admin/structure/taxonomy/manage/product_categories/overview", "selector": "form", "padding": 16, "viewport": {"width": 1100, "height": 1800}, "actions": [{"eval": "const order = [[\"Women\", \"\"], [\"Men\", \"\"], [\"Apothecary\", \"\"], [\"Urban Living\", \"\"], [\"Food & Beverage\", \"Urban Living\"], [\"Home\", \"Urban Living\"], [\"Accessories\", \"Home\"], [\"Kitchen\", \"Home\"], [\"Office\", \"Home\"], [\"Furnishings\", \"Home\"], [\"Outdoors\", \"Urban Living\"], [\"Accessories\", \"Outdoors\"], [\"Toys/Novelties\", \"Urban Living\"], [\"Pool Toys\", \"Toys/Novelties\"], [\"Beach\", \"Urban Living\"], [\"Inflatables\", \"Beach\"], [\"Audio & Film\", \"\"], [\"Audio\", \"Audio & Film\"], [\"Film\", \"Audio & Film\"], [\"Print Shop\", \"\"], [\"Electronics\", \"\"]];\nconst rows = {}, last = {}, depth = {};\ndocument.querySelectorAll('form tbody tr').forEach((r) => { const n = r.querySelector('a[href*=\"/taxonomy/term/\"]').textContent.trim(); (rows[n] ||= []).push(r); });\norder.forEach(([name, parent], i) => {\n  const r = rows[name].shift();\n  last[name] = r;\n  const pid = parent ? last[parent].querySelector(\"input[name$='[term][tid]']\").value : '0';\n  depth[name] = parent ? depth[parent] + 1 : 0;\n  r.querySelector(\"input[name$='[term][parent]']\").value = pid;\n  r.querySelector(\"input[name$='[term][depth]']\").value = depth[name];\n  const w = r.querySelector(\"select[name$='[weight]']\");\n  if (![...w.options].some((o) => o.value == i)) w.add(new Option(i, i));\n  w.value = i;\n});"}, {"click": "form input[type=submit][value=Save]"}, {"wait": 2500}]},
